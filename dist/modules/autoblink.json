{
  "id": "autoblink",
  "title": "AutoBlink",
  "description": "Моргание по таймеру: интервал, длительность закрытия и разброс, чтобы не было метронома.",
  "kind": "autoblink",
  "format": 1,
  "audio": false,
  "inputs": [
    { "name": "blink", "label": "Моргание", "kind": "level", "min": 0, "max": 1 }
  ],
  "fields": [
    { "key": "period", "label": "Интервал", "type": "number", "min": 500, "max": 20000, "step": 100, "default": 4200, "suffix": "мс", "hint": "Среднее время между морганиями." },
    { "key": "hold", "label": "Длительность", "type": "number", "min": 40, "max": 2000, "step": 10, "default": 140, "suffix": "мс", "hint": "Сколько вход держится в максимуме." },
    { "key": "jitter", "label": "Разброс", "type": "number", "min": 0, "max": 90, "step": 5, "default": 35, "suffix": "%", "hint": "Случайное отклонение интервала." },
    { "key": "min", "label": "Минимум", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0 },
    { "key": "max", "label": "Максимум", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 1 }
  ],
  "defaults": { "period": 4200, "hold": 140, "jitter": 35, "min": 0, "max": 1 }
}
