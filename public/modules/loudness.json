{
  "id": "loudness",
  "title": "Loudness",
  "description": "Уровень речи с микрофона: сглаженная громкость, пик, децибелы и флаг разговора.",
  "kind": "loudness",
  "audio": true,
  "inputs": [
    { "name": "speak", "label": "Речь (сглаженная)", "kind": "level", "min": 0, "max": 1 },
    { "name": "loudness", "label": "Пик", "kind": "level", "min": 0, "max": 1 },
    { "name": "db", "label": "Децибелы", "kind": "db", "min": -80, "max": 0, "step": 1 },
    { "name": "talking", "label": "Разговор", "kind": "flag", "min": 0, "max": 1, "step": 1 }
  ],
  "fields": [
    { "key": "deviceId", "label": "Устройство", "type": "device", "default": "default" },
    { "key": "gain", "label": "Усиление", "type": "number", "min": 0.1, "max": 8, "step": 0.1, "default": 1, "suffix": "×" },
    { "key": "threshold", "label": "Порог речи", "type": "number", "min": -80, "max": 0, "step": 1, "default": -43, "suffix": "дБ" },
    { "key": "processing", "label": "Шумоподавление", "type": "flag", "default": false }
  ],
  "defaults": { "gain": 1, "threshold": -43, "processing": false }
}
