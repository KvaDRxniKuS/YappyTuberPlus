    {
      "key": "gate",
      "label": "Порог слышимости",
      "type": "number",
      "min": -80,
      "max": 0,
      "step": 1,
      "default": -50,
      "suffix": "дБ",
      "hint": "Ниже порога все виземы нулевые."
